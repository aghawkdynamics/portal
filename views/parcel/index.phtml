                                                var map = L.map(minimapId, {
                                                    attributionControl: false,
                                                    zoomControl: false,
                                                    dragging: false,
                                                    scrollWheelZoom: false,
                                                    doubleClickZoom: false
                                                }).setView([<?= $p['latitude'] ?>, <?= $p['longitude'] ?>], 10);

