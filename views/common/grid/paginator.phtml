    </style>
    <form method="POST">
        <div class="paginator">
            <?php if ($_page > 1): ?>
                <?= paginatorPageLink($_page - 1, '« Prev') ?>
            <?php endif; ?>

            <?php
            // Show first page
            if ($_page > 3) {
                echo paginatorPageLink(1);
                if ($_page > 4) {
                    echo '<span class="paginator-ellipsis">…</span>';
                }
            }

            // Show range around current page
            $start = max(1, $_page - 2);
            $end = min($_pages, $_page + 2);
            for ($i = $start; $i <= $end; $i++) {
                echo paginatorPageLink($i, null, $i == $_page);
            }

            // Show last page
            if ($_page < $_pages - 2) {
                if ($_page < $_pages - 3) {
                    echo '<span class="paginator-ellipsis">…</span>';
                }
                echo paginatorPageLink($_pages);
            }
            ?>

            <?php if ($_page < $_pages): ?>
                <?= paginatorPageLink($_page + 1, 'Next »') ?>
            <?php endif; ?>


